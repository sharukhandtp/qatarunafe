# Where the Vite dev server proxies /api during `npm run dev`.
# Matches the "http" profile in QatarUna.Api/Properties/launchSettings.json.
VITE_API_PROXY_TARGET=http://localhost:5137

# Absolute API origin for a production build served from a different host.
# Leave empty when the SPA and the API share an origin (reverse proxy).
VITE_API_BASE_URL=
